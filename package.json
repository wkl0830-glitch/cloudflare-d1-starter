{
  "name": "cloudflare-d1-starter",
  "version": "1.0.0",
  "description": "Cloudflare Workers + Hono + D1 Fullstack Starter for OpenCode",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create my-starter-db",
    "db:migrate:local": "wrangler d1 migrations apply my-starter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply my-starter-db --remote"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.111.0"
  }
}
